@page "/myattendance"
@inject HttpClient Http

<h3>Devamsızlığım</h3>
@if (items == null)
{
    <p>Yükleniyor...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Ders</th>
                <th>Tarih</th>
                <th>Durum</th>
                <th>Not</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in items)
            {
                <tr>
                    <td>@a.course</td>
                    <td>@a.date.ToString("yyyy-MM-dd")</td>
                    <td>@(a.isPresent ? "Var" : "Yok")</td>
                    <td>@a.note</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    record AttDto(int courseId, string course, DateTime date, bool isPresent, string? note);
    List<AttDto>? items;
    protected override async Task OnInitializedAsync()
    => items = await Http.GetFromJsonAsync<List<AttDto>>("/api/attendance/me");
}
